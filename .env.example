# Copy to .env and adjust. Every value is optional; the defaults are shown.
# No API keys are needed: all models run locally through Ollama.

# --- Ollama -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=deepseek-r1:14b      # use deepseek-r1:8b on machines with less memory
LLM_TEMPERATURE=0.6            # DeepSeek recommends 0.5-0.7 for R1 (lower values can repeat)
LLM_REASONING=false            # Ollama think switch; deepseek-r1 reasons anyway (reasoning is hidden)
LLM_NUM_CTX=16384              # context window in tokens; prompt + reasoning must fit
EMBED_MODEL=bge-m3

# --- Storage ------------------------------------------------------------
DATA_DIR=data                  # PDFs in DATA_DIR/raw, extracted pages in DATA_DIR/processed
CHROMA_DIR=data/chroma
COLLECTION_NAME=pdf_rag

# --- Ingestion / retrieval ---------------------------------------------
OCR_LANG=eng+mar               # tesseract languages; missing packs are skipped with a warning
OCR_MODE=auto                  # auto (scanned or garbled pages only) | always | never
OCR_DPI=300
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
